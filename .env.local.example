# Supabase (voir README.md pour la procédure complète de setup)
# Project Settings → API, dans le projet Supabase ciblé (dev en local, prod
# en production — ne jamais utiliser la même valeur dans les deux, ni
# exposer la service role key côté client).
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=xxxxx

# Estimation loyer via Gemini + recherche Google (palier gratuit, clé sur
# aistudio.google.com/apikey — pas de carte bancaire requise)
GEMINI_API_KEY=xxxxx

# Supabase — clés publiques (client navigateur, auth uniquement)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=xxxxx

# Stripe (voir docs/setup-stripe.md pour la procédure complète)
# Développeurs → Clés API. sk_test_… en dev, sk_live_… en prod.
STRIPE_SECRET_KEY=sk_test_xxxxx
# Payment links → le lien du produit Pro, avec redirection vers /upgrade/success
NEXT_PUBLIC_STRIPE_PAYMENT_LINK=https://buy.stripe.com/test_xxxxx
# `stripe listen` en local, Développeurs → Webhooks en prod.
# Sans lui le webhook refuse tout : c'est ce qui empêche un tiers de faire
# passer un compte en Pro en appelant l'URL à la main.
STRIPE_WEBHOOK_SECRET=whsec_xxxxx
